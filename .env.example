# ============================================================
# BarberAgenda — Variáveis de Ambiente
# NUNCA commite o .env no git!
# ============================================================
# IMPORTANTE: este é um app React estático (Vite).
# Variáveis VITE_* são substituídas em BUILD-TIME — não funcionam
# como env vars do container em produção.
#
# Em produção (EasyPanel/Docker): use as vars SEM prefixo VITE_
# abaixo — elas são injetadas pelo docker-entrypoint.sh em runtime.
#
# Em desenvolvimento local: use as vars VITE_* no .env.local
# ============================================================

# ── PRODUÇÃO — variáveis de ambiente do container (EasyPanel) ─
# Estas são lidas pelo docker-entrypoint.sh e injetadas no
# window.__BARBER_CONFIG__ antes de o Nginx servir o app.

# Evolution Go (Evo Go) — WhatsApp
EVO_URL=https://evo.seudominio.com.br
EVO_INSTANCE=barberflow
EVO_APIKEY=SUA_GLOBAL_API_KEY_AQUI

# Postgres
POSTGRES_DB=barberflow
POSTGRES_USER=barber_user
POSTGRES_PASSWORD=senha_forte_aqui

# Redis
REDIS_PASSWORD=outra_senha_forte_aqui

# PgAdmin (opcional)
PGADMIN_EMAIL=admin@barberflow.com.br
PGADMIN_PASSWORD=senha_pgadmin_aqui

# App
NODE_ENV=production


# ── DESENVOLVIMENTO LOCAL — .env.local (nunca vai para produção) ──
# Copie as linhas abaixo para um arquivo .env.local na raiz do projeto.
# O Vite lê .env.local automaticamente em modo dev.

# VITE_EVO_URL=https://evo.seudominio.com.br
# VITE_EVO_INSTANCE=barberflow
# VITE_EVO_APIKEY=SUA_GLOBAL_API_KEY_AQUI
# VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...
