# ============================================================
# BarberAgenda — Variáveis de Ambiente
# Copie para .env e preencha os valores reais
# NUNCA commite o .env no git!
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=production

# ── Supabase (se usar Supabase como backend) ─────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# ── Evolution Go (Evo Go) — WhatsApp ────────────────────────
# URL pública do Evo Go no EasyPanel (sem barra no final)
VITE_EVO_URL=https://evo.seudominio.com.br
# Nome da instância criada no Evo Go
VITE_EVO_INSTANCE=barberflow
# Mesma chave do GLOBAL_API_KEY do .env do Evo Go no EasyPanel
VITE_EVO_APIKEY=SUA_GLOBAL_API_KEY_AQUI

# ── Variáveis do próprio serviço Evo Go (no EasyPanel) ──────
# (Configure diretamente no painel do EasyPanel, não aqui)
# SERVER_PORT=8080
# CLIENT_NAME=evolution
# GLOBAL_API_KEY=SUA_CHAVE_FORTE_32CHARS
# POSTGRES_AUTH_DB=postgresql://user:pass@postgres:5432/evogo_auth?sslmode=disable
# POSTGRES_USERS_DB=postgresql://user:pass@postgres:5432/evogo_users?sslmode=disable
# CONNECT_ON_STARTUP=true
# DATABASE_SAVE_MESSAGES=true
# WEBHOOK_URL=https://barberflow.seudominio.com.br/webhook/evolution
# WEBHOOK_FILES=true
# WADEBUG=INFO
# LOGTYPE=json
# MINIO_ENABLED=true
# MINIO_ENDPOINT=minio.seudominio.com:9000
# MINIO_ACCESS_KEY=sua_access_key
# MINIO_SECRET_KEY=sua_secret_key
# MINIO_BUCKET=evolution-media
# MINIO_USE_SSL=true

# ── Banco de dados direto (se usar Postgres próprio) ─────────
DATABASE_URL=postgresql://barber_user:SENHA@postgres:5432/barberflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=barberflow
POSTGRES_USER=barber_user
# Senha definida como Docker Secret — não colocar aqui em produção

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://:SENHA@redis:6379
# Senha definida como Docker Secret — não colocar aqui em produção

# ── Registry / Deploy ────────────────────────────────────────
REGISTRY=registry.easypanel.io
PROJECT=barberflow
TAG=latest
STACK_NAME=barberflow

# ── PgAdmin (opcional) ───────────────────────────────────────
PGADMIN_EMAIL=admin@barberflow.com.br
PGADMIN_PASSWORD=troque_esta_senha!

# ── Secrets GitHub Actions (configurar em Settings > Secrets) ─
# EASYPANEL_REGISTRY=registry.easypanel.io
# REGISTRY_USER=seu_usuario
# REGISTRY_PASSWORD=seu_token
# DEPLOY_HOST=IP_DO_SERVIDOR
# DEPLOY_USER=ubuntu
# DEPLOY_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----...
# DEPLOY_PORT=22
